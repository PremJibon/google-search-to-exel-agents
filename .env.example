# LeadFinder Environment Configuration
# Default mode is 100% FREE using OpenStreetMap. No API keys required!

# Google Maps via Serper API Key (Free 2,500 queries at https://serper.dev - no credit card)
SERPER_API_KEY=

# Tavily Web Search API Key (Free 1,000 searches/mo at https://tavily.com)
TAVILY_API_KEY=

# OpenRouter Free LLM API Key (Free models at https://openrouter.ai)
OPENROUTER_API_KEY=

# Optional: Official Google Cloud Places API Key (requires credit card/billing)
GOOGLE_MAPS_API_KEY=

# Optional custom Overpass interpreter endpoint
# Default: https://overpass-api.de/api/interpreter
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# User-Agent for Nominatim OSM compliance
APP_USER_AGENT=LeadFinderFree/1.0 (local-lead-finder-agent)

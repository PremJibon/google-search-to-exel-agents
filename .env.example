# ========================================================
# LeadFinder Free & Agency Co-Pilot - Environment Template
# ========================================================

# 🛡️ Zero-Trust Security Passkey (Optional but Recommended for Public Hosting)
# If set, users must enter this passkey to access the dashboard and AI chat.
# Leave empty for open/local development mode.
APP_ACCESS_PASSWORD=

# ⚡ Primary AI Engine: Groq API Key (Free tier at https://console.groq.com/keys)
# Ultra-fast LPU inference (500+ tokens/sec) powering Apex, Nova, Max, and Atlas.
GROQ_API_KEY=

# 🌐 Deep Search & Footprint Intelligence: Tavily API Key (Free tier at https://tavily.com)
TAVILY_API_KEY=

# 🤖 Secondary Multi-Model Gateway: OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 🧩 Helper LLM: BazaarLink AI (OpenAI-compatible assistant at https://api.bazaarlink.ai/v1)
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1
BAZAARLINK_API_KEY=

# 📍 Google Maps via Serper API Key (Free 2,500 queries at https://serper.dev - no credit card)
SERPER_API_KEY=

# 🏢 Optional: Google Cloud Places API Key (requires billing on GCP)
GOOGLE_MAPS_API_KEY=

# User-Agent for Nominatim OSM compliance
APP_USER_AGENT=LeadFinderFree/2.1 (contact: github-lead-finder)
